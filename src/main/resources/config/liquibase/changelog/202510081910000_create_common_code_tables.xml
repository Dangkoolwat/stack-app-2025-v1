<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.21.xsd">

  <!-- ============================================================ -->
  <!--  Sequence for CommonCodeDetail (Oracle 전용)                 -->
  <!-- ============================================================ -->
  <!-- === 공통 Property 선언 === -->
  <property name="now" value="now()" dbms="h2"/>
  <property name="now" value="sysdate" dbms="oracle"/>
  <property name="floatType" value="float4" dbms="postgresql, h2"/>
  <property name="floatType" value="float" dbms="mysql, oracle, mssql, mariadb"/>
  <property name="clobType" value="clob" dbms="h2, oracle"/>
  <property name="clobType" value="longtext" dbms="mysql, mariadb"/>
  <property name="uuidType" value="uuid" dbms="h2, postgresql"/>
  <property name="datetimeType" value="datetime(6)" dbms="mysql, mariadb"/>
  <property name="datetimeType" value="datetime" dbms="oracle, mssql, postgresql, h2"/>

  <changeSet id="seq-common-detail" author="steve">
    <createSequence
      sequenceName="common_detail_sequence_generator"
      startValue="1"
      incrementBy="1"
      cacheSize="20"/>
  </changeSet>

  <!-- ============================================================ -->
  <!--  Table: stack_common_group                                   -->
  <!-- ============================================================ -->
  <changeSet id="create-stack-common-group" author="steve">

    <createTable tableName="stack_common_group">

      <column name="group_code" type="VARCHAR2(50)">
        <constraints primaryKey="true" nullable="false" primaryKeyName="pk_stack_common_group"/>
      </column>

      <column name="group_name" type="VARCHAR2(100)">
        <constraints nullable="false"/>
      </column>

      <column name="display_order" type="NUMBER(10,0)"/>

      <column name="is_deleted" type="NUMBER(1,0)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="description" type="VARCHAR2(255)"/>

      <!-- Auditing columns (if AbstractAuditingEntity used globally) -->
      <column name="created_by" type="VARCHAR2(50)"/>
      <column name="created_date" type="${datetimeType}" defaultValueComputed="${now}"/>
      <column name="last_modified_by" type="VARCHAR2(50)"/>
      <column name="last_modified_date" type="${datetimeType}" defaultValueComputed="${now}"/>

    </createTable>

    <!-- 인덱스 -->
    <createIndex indexName="ix_stack_group_deleted" tableName="stack_common_group">
      <column name="is_deleted"/>
    </createIndex>

    <createIndex indexName="ix_stack_group_display_order" tableName="stack_common_group">
      <column name="display_order"/>
    </createIndex>

  </changeSet>

  <!-- ============================================================ -->
  <!--  Table: stack_common_code_detail                             -->
  <!-- ============================================================ -->
  <changeSet id="create-stack-common-code-detail" author="steve">

    <createTable tableName="stack_common_code_detail">

      <column name="id" type="NUMBER(19,0)">
        <constraints primaryKey="true" nullable="false" primaryKeyName="pk_stack_common_detail"/>
      </column>

      <column name="group_code" type="VARCHAR2(50)">
        <constraints nullable="false"/>
      </column>

      <column name="code" type="VARCHAR2(50)">
        <constraints nullable="false"/>
      </column>

      <column name="name" type="VARCHAR2(100)">
        <constraints nullable="false"/>
      </column>

      <column name="sort_order" type="NUMBER(10,0)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="is_deleted" type="NUMBER(1,0)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="version" type="NUMBER(10,0)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <!-- 확장 필드 -->
      <column name="attribute1" type="VARCHAR2(255)"/>
      <column name="attribute2" type="VARCHAR2(255)"/>
      <column name="attribute3" type="VARCHAR2(255)"/>
      <column name="attribute4" type="VARCHAR2(255)"/>
      <column name="attribute5" type="VARCHAR2(255)"/>

      <column name="description" type="VARCHAR2(255)"/>

      <!-- Auditing columns -->
      <column name="created_by" type="VARCHAR2(50)"/>
      <column name="created_date" type="${datetimeType}" defaultValueComputed="${now}"/>
      <column name="last_modified_by" type="VARCHAR2(50)"/>
      <column name="last_modified_date" type="${datetimeType}" defaultValueComputed="${now}"/>

    </createTable>

    <!-- Unique constraint (GROUP_CODE + CODE) -->
    <addUniqueConstraint
      tableName="stack_common_code_detail"
      columnNames="group_code, code"
      constraintName="uk_stack_group_code_detail"/>

    <!-- Foreign key -->
    <addForeignKeyConstraint
      baseTableName="stack_common_code_detail"
      baseColumnNames="group_code"
      constraintName="fk_stack_detail_group"
      referencedTableName="stack_common_group"
      referencedColumnNames="group_code"/>

    <!-- 인덱스 -->
    <createIndex indexName="ix_stack_detail_group" tableName="stack_common_code_detail">
      <column name="group_code"/>
    </createIndex>

    <createIndex indexName="ix_stack_detail_sort_order" tableName="stack_common_code_detail">
      <column name="sort_order"/>
    </createIndex>

    <createIndex indexName="ix_stack_detail_deleted" tableName="stack_common_code_detail">
      <column name="is_deleted"/>
    </createIndex>

  </changeSet>

