<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- “따옴표를 붙이지 않고, 데이터베이스의 고유 대소문자 규칙을 그대로 따르는” Liquibase 동작 모드 -->
  <!-- 따라서 Oracle에서는 —XML에서 소문자로 적어도 자동으로 대문자 객체(USER_TABLE, USER_SEQUENCE) 로 생성. -->
  <property name="liquibase.objectQuotingStrategy" value="LEGACY"/>

  <!-- === 공통 Property 선언 === -->
  <property name="now" value="now()" dbms="h2"/>
  <property name="now" value="sysdate" dbms="oracle"/>
  <property name="floatType" value="float4" dbms="postgresql, h2"/>
  <property name="floatType" value="float" dbms="mysql, oracle, mssql, mariadb"/>
  <property name="clobType" value="clob" dbms="h2, oracle"/>
  <property name="clobType" value="longtext" dbms="mysql, mariadb"/>
  <property name="uuidType" value="uuid" dbms="h2, postgresql"/>
  <property name="datetimeType" value="datetime(6)" dbms="mysql, mariadb"/>
  <property name="datetimeType" value="datetime" dbms="oracle, mssql, postgresql, h2"/>


