<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration scan="true">

  <!-- CRLF 변환기 -->
  <!-- Patterns based on https://github.com/spring-projects/spring-boot/blob/v3.0.0/spring-boot-project/spring-boot/src/main/resources/org/springframework/boot/logging/logback/defaults.xml -->
  <conversionRule conversionWord="crlf" class="com.daangcool.stack.config.CRLFLogConverter"/>

  <!-- 기본 패턴 -->
  <property name="CONSOLE_LOG_PATTERN"
            value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %crlf(%m){red}%n%wEx"/>

  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <!-- 내 코드 -->
  <logger name="com.daangcool.stack" level="INFO"/>

  <!-- Spring Boot 핵심은 INFO 유지 -->
  <logger name="org.springframework" level="INFO"/>
  <logger name="org.springframework.boot" level="INFO"/>
  <logger name="org.springframework.context" level="INFO"/>
  <logger name="org.springframework.web" level="INFO"/>
  <logger name="org.springframework.security" level="INFO"/>
  <logger name="org.springframework.cache" level="INFO"/>
  <logger name="org.springframework.boot.autoconfigure.logging" level="INFO"/>

  <!-- Hibernate 잡음 억제 -->
  <logger name="org.hibernate" level="WARN"/>
  <logger name="org.hibernate.SQL" level="WARN"/>
  <logger name="org.hibernate.type" level="WARN"/>
  <logger name="org.hibernate.validator" level="WARN"/>
  <logger name="org.hibernate.ejb.HibernatePersistence" level="OFF"/>

  <!-- 데이터소스 -->
  <logger name="com.zaxxer.hikari" level="WARN"/>

  <!-- 톰캣/Undertow/Netty -->
  <logger name="org.apache.catalina" level="WARN"/>
  <logger name="org.apache.coyote" level="WARN"/>
  <logger name="io.undertow" level="WARN"/>
  <logger name="io.netty" level="WARN"/>
  <logger name="org.xnio" level="WARN"/>

  <!-- 메시징/캐시 -->
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="org.redisson" level="WARN"/>
  <logger name="org.eclipse.paho.client.mqttv3.internal" level="WARN"/>

  <!-- DB 마이그레이션 -->
  <logger name="liquibase" level="INFO"/>
  <logger name="LiquibaseSchemaResolver" level="INFO"/>
  <logger name="org.flywaydb" level="WARN"/>

  <!-- 기타 noisy libraries -->
  <logger name="angus.activation" level="WARN"/>
  <logger name="jakarta.activation" level="WARN"/>
  <logger name="jakarta.mail" level="WARN"/>
  <logger name="jakarta.management.remote" level="WARN"/>
  <logger name="jakarta.xml.bind" level="WARN"/>
  <logger name="com.sun" level="WARN"/>
  <logger name="org.bson" level="WARN"/>
  <logger name="org.thymeleaf" level="WARN"/>


  <!-- Boot에서 잡음 많은 로거들 강제 낮춤 -->
  <logger name="org.springframework.context.annotation.ConfigurationClassParser" level="ERROR"/>
  <logger name="org.springframework.context.support.PostProcessorRegistrationDelegate$BeanPostProcessorChecker" level="ERROR"/>
  <logger name="org.springframework.web.servlet.HandlerMapping.Mappings" level="WARN"/>

  <!-- 예외적으로 INFO 허용 -->
  <logger name="io.swagger.v3" level="INFO"/>
  <logger name="Validator" level="INFO"/>
  <logger name="jdk.event.security" level="INFO"/>

  <!-- RMI/JMX 잡음 억제 -->
  <logger name="sun.rmi.transport.tcp" level="WARN"/>
  <logger name="sun.rmi" level="WARN"/>
  <logger name="sun.rmi.transport" level="WARN"/>
  <logger name="javax.management.remote.rmi" level="WARN"/>

  <!-- Hibernate incubating warnings 숨기기 -->
  <logger name="org.hibernate.orm.incubating" level="ERROR"/>


  <!-- Dev 프로파일: 콘솔만 -->
  <springProfile name="dev">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <!-- Prod 프로파일: RollingFileAppender -->
  <springProfile name="prod">
    <!-- 커스텀 프로퍼티(application.yml에서 주입) -->
    <springProperty name="LOG_PATH" source="application.logging.file-path" defaultValue="./logs"/>
    <springProperty name="LOG_MAX_HISTORY" source="application.logging.max-history" defaultValue="30"/>
    <springProperty name="LOG_TOTAL_SIZE_CAP" source="application.logging.total-size-cap" defaultValue="1GB"/>
    <springProperty name="LOG_MAX_FILE_SIZE" source="application.logging.max-file-size" defaultValue="10MB"/>

    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_PATH}/application.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_PATH}/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
        <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
        <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
      </rollingPolicy>
      <encoder>
        <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        <charset>UTF-8</charset>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="ROLLING"/>
    </root>
  </springProfile>

  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>

</configuration>

