{
  "mcpServers": {
    "serena": {
      "command": "caveman-shrink",
      "args": [
        "serena",
        "start-mcp-server",
        "--context=jb-ai-assistant",
        "--project-from-cwd"
      ]
    },
    "sequential-thinking": {
      "command": "caveman-shrink",
      "args": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "code-review-graph": {
      "command": "caveman-shrink",
      "args": [
        "uvx",
        "code-review-graph",
        "serve",
        "--tools",
        "query_graph_tool,semantic_search_nodes_tool,detect_changes_tool,get_review_context_tool,get_impact_radius_tool,get_architecture_overview_tool"
      ]
    }
  }
}