{
  "mcpServers": {
    "serena": {
      "command": "caveman-shrink",
      "args": [
        "serena",
        "start-mcp-server",
        "--context=jb-ai-assistant",
        "--project-from-cwd"
      ]
    },
    "code-review-graph": {
      "command": "caveman-shrink",
      "args": [
        "uvx",
        "code-review-graph",
        "serve"
      ]
    },
    "sequential-thinking": {
      "command": "caveman-shrink",
      "args": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "semble": {
      "command": "caveman-shrink",
      "args": ["uvx", "--from", "semble[mcp]", "semble"]
    }
  }
}
