#!/bin/bash

# 1. JWT Secret 확인 및 생성 (없을 경우에만 생성)
if ! grep -q "^JWT_SECRET=" .env || [ -z "$(grep "^JWT_SECRET=" .env | cut -d'=' -f2)" ]; then
    NEW_JWT_SECRET=$(openssl rand -base64 64 | tr -d '\n')
    # .env 파일에 JWT_SECRET 추가 또는 교체
    if grep -q "^JWT_SECRET=" .env; then
        sed -i.bak "s|^JWT_SECRET=.*|JWT_SECRET=${NEW_JWT_SECRET}|" .env
    else
        echo "JWT_SECRET=${NEW_JWT_SECRET}" >> .env
    fi
    echo "New JWT_SECRET generated and updated in .env"
else
    echo "Using existing JWT_SECRET from .env"
fi

# 4. 레디스 데이터 초기화
echo "Running: docker exec edenhtwebapp-redis-1 redis-cli FLUSHALL"
docker exec edenhtwebapp-redis-1 redis-cli FLUSHALL || echo "Redis flush failed (check container name)"

# 5. 환경 변수 로드 및 스프링 부트 실행 (프로필 추가)
echo "Running: export \$(cat .env | grep -v '^#' | xargs) && ./mvnw spring-boot:run -Pdev,local-tls,api-docs"
export $(cat .env | grep -v '^#' | xargs) && ./mvnw spring-boot:run -Pdev,local-tls,api-docs
